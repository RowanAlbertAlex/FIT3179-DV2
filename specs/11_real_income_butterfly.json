          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 735
          },
          "y": {
            "value": 376
          },
          "text": {
            "value": "Real weekly household income ($)"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#465564"
          }
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
