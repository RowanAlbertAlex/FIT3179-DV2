{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Distribution of SA2 median weekly household incomes within each Australian state and territory.",
  "data": {
    "url": "data/04_state_sa2_boxplot_summary.csv",
    "format": {
      "type": "csv",
      "parse": {
        "min_income": "number",
        "q1_income": "number",
        "median_income": "number",
        "q3_income": "number",
        "max_income": "number",
        "sa2_count": "number"
      }
    }
  },
  "title": {
    "text": "Local incomes can vary widely within the same state",
    "subtitle": "The box shows the middle half of local SA2 incomes; the dark line marks the median and the whiskers show the full range.",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 24,
    "fontWeight": "normal",
    "subtitleFont": "Arial",
    "subtitleFontSize": 14,
    "subtitleColor": "#465564",
    "offset": 20
  },
  "width": "container",
  "height": {
    "step": 46
  },
  "encoding": {
    "y": {
      "field": "state_abbr",
      "type": "nominal",
      "sort": [
        "ACT",
        "NT",
        "VIC",
        "WA",
        "NSW",
        "QLD",
        "SA",
        "TAS"
      ],
      "axis": {
        "title": null,
        "labelFont": "Arial",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelColor": "#465564",
        "labelPadding": 10,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#82918f",
        "strokeWidth": 1.4
      },
      "encoding": {
        "x": {
          "field": "min_income",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "domain": [
              700,
              4100
            ]
          },
          "axis": {
            "title": "Median weekly household income of local SA2 ($)",
            "titleFont": "Arial",
            "titleFontSize": 12,
            "titleFontWeight": "normal",
            "titleColor": "#465564",
            "titlePadding": 12,
            "values": [
              1000,
              1500,
              2000,
              2500,
              3000,
              3500,
              4000
            ],
            "labelFont": "Arial",
            "labelFontSize": 11,
            "labelColor": "#465564",
            "labelExpr": "'$' + format(datum.value, ',.0f')",
            "grid": false,
            "domainColor": "#aaa298",
            "tickColor": "#aaa298"
          }
        },
        "x2": {
          "field": "max_income"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": 24,
        "fill": "#7fada5",
        "stroke": "#367a73",
        "strokeWidth": 1.1
      },
      "encoding": {
        "x": {
          "field": "q1_income",
          "type": "quantitative"
        },
        "x2": {
          "field": "q3_income"
        }
      }
    },
    {
      "mark": {
        "type": "tick",
        "orient": "vertical",
        "size": 24,
        "thickness": 1.4,
        "color": "#82918f"
      },
      "encoding": {
        "x": {
          "field": "min_income",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "tick",
        "orient": "vertical",
        "size": 24,
        "thickness": 1.4,
        "color": "#82918f"
      },
      "encoding": {
        "x": {
          "field": "max_income",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "tick",
        "orient": "vertical",
        "size": 24,
        "thickness": 2,
        "color": "#17243a"
      },
      "encoding": {
        "x": {
          "field": "median_income",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": 30,
        "opacity": 0
      },
      "encoding": {
        "x": {
          "field": "min_income",
          "type": "quantitative"
        },
        "x2": {
          "field": "max_income"
        },
        "tooltip": [
          {
            "field": "state_abbr",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "min_income",
            "type": "quantitative",
            "title": "Minimum",
            "format": "$,.0f"
          },
          {
            "field": "q1_income",
            "type": "quantitative",
            "title": "Q1",
            "format": "$,.0f"
          },
          {
            "field": "median_income",
            "type": "quantitative",
            "title": "Median",
            "format": "$,.0f"
          },
          {
            "field": "q3_income",
            "type": "quantitative",
            "title": "Q3",
            "format": "$,.0f"
          },
          {
            "field": "max_income",
            "type": "quantitative",
            "title": "Maximum",
            "format": "$,.0f"
          },
          {
            "field": "sa2_count",
            "type": "quantitative",
            "title": "SA2s included",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    }
  }
}