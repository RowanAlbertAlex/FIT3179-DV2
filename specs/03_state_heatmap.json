  "transform": [
    {
      "calculate": "datum.share - datum.national_share",
      "as": "diff"
    }
  ],

  "title": {
    "text": "How do states differ from the national income profile?",
    "subtitle": "Blue means a smaller-than-national share; gold means a larger-than-national share in that income group.",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 24,
    "fontWeight": "normal",
    "subtitleFont": "Arial",
    "subtitleFontSize": 14,
    "subtitleColor": "#465564",
    "offset": 18
  },

  "mark": {
    "type": "rect",
    "stroke": "#fffdf8",
    "strokeWidth": 2
  },

  "encoding": {
    "x": {
      "field": "band",
      "type": "ordinal",
      "sort": {
        "field": "order",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "title": null,
        "labelFont": "Arial",
        "labelFontSize": 12,
        "labelColor": "#465564",
        "labelAngle": 0,
        "labelPadding": 10,
        "tickSize": 0,
        "domain": false
      }
    },

    "y": {
      "field": "state",
      "type": "ordinal",
      "sort": ["ACT", "NT", "WA", "NSW", "VIC", "QLD", "SA", "TAS"],
      "axis": {
        "title": null,
        "labelFont": "Arial",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelColor": "#465564",
        "labelPadding": 8,
        "tickSize": 0,
        "domain": false
      }
    },

    "color": {
      "field": "diff",
      "type": "quantitative",
      "scale": {
        "domain": [-9, 0, 9],
        "range": ["#5d7896", "#f6f1e8", "#c99b3d"]
      },
    "legend": {
    "title": "Difference from national share (percentage points)",
    "titleLimit": 500,

    "titleFont": "Arial",
    "titleFontSize": 12,
    "titleFontWeight": "bold",
    "titleColor": "#465564",

    "labelFont": "Arial",
    "labelFontSize": 11,
    "labelColor": "#465564",

    "values": [-8, -4, 0, 4, 8],

    "gradientLength": 300,
    "gradientThickness": 14,

    "orient": "bottom",
    "direction": "horizontal"
    }
    },

    "tooltip": [
      {
        "field": "state",
        "type": "ordinal",
        "title": "State / territory"
      },
      {
        "field": "band",
        "type": "ordinal",
        "title": "Weekly household income"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "State share",
        "format": ".1f"
      },
      {
        "field": "national_share",
        "type": "quantitative",
        "title": "National share",
        "format": ".1f"
      },
      {
        "field": "diff",
        "type": "quantitative",
        "title": "Difference (pp)",
        "format": "+.1f"
      }
    ]
  },

  "width": "container",

  "height": {
    "step": 48
  },

  "config": {
    "background": null,
    "view": {
      "stroke": null
    }
  }
}